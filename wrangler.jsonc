{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "memegen-rs",
  "account_id": "3db7dd8ff22ae68593205855d8bc0b25",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-17",
  "observability": {
    "enabled": true
  },
  "vars": {
    "EXTRA_HTML_SCRIPTS": "<script defer src=\"/mesh/script.js\" data-site-id=\"84199879b537\"></script>"
  },
  "routes": [
    { "pattern": "memegen.rs", "custom_domain": true }
  ],
  // A runaway-bill backstop, not a fairness limiter - enforced at the edge
  // (worker.ts) on a single shared key, so it caps *aggregate* render
  // throughput per Cloudflare location regardless of how many IPs flood it.
  // Generous on purpose (no real user should ever trip it); only cache-miss
  // renders count. period must be 10 or 60s; 10000 / 60s is ~166 renders/s.
  "ratelimits": [
    {
      "name": "RENDER_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10000, "period": 60 }
    }
  ],
  "containers": [
    {
      // For the first deploy, wrangler builds this Containerfile locally and
      // pushes it to Cloudflare's registry. Once CI pushes pre-built images,
      // swap this for "registry.cloudflare.com/<ACCOUNT_ID>/memegen-rs:<sha>".
      "image": "./Containerfile",
      "class_name": "MemegenContainer",
      "instance_type": "basic",
      // The Worker routes all traffic to one instance via getContainer() (the
      // built-in cf-singleton-container id). Pin the ceiling to 1 so the
      // platform can never hold more than one instance (avoids stray instances
      // from earlier experiments lingering against the cap during a rollout).
      "max_instances": 1,
      // Replace an active instance immediately on deploy instead of waiting out
      // a grace period (paired with --containers-rollout=immediate in CI and
      // SIGTERM handling in the server, deploys roll the new image right away).
      "rollout_active_grace_period": 0
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MEMEGEN",
        "class_name": "MemegenContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MemegenContainer"]
    }
  ]
}
